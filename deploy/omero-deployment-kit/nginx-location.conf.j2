# Insert inside the HTTPS server block in
# roles/base/templates/omero.conf.j2. Nginx runs on the host in this
# deployment, so this is a host path rather than the OMERO.web container path.
location /_biomero_zarr_internal/ {
    internal;
    alias {{ biomero_zarr_nginx_root }}/;
    sendfile on;
    tcp_nopush on;
    etag on;
    autoindex off;
    disable_symlinks on;

    types {
        application/json json zattrs zarray zgroup zmetadata;
        application/octet-stream bin;
    }
    default_type application/octet-stream;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "private, max-age=300" always;
}
