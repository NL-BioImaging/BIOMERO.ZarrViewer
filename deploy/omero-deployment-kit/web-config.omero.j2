# Append to roles/docker/templates/web_conf.omero.j2.

config append -- omero.web.apps '"biomero_zarr_viewer"'
config append -- omero.web.open_with '["biomero_zarr_viewer", "biomero_zarr_viewer_index", {"supported_objects": ["image", "plate", "well"], "label": "OME-Zarr Viewer", "target": "_blank", "script_url": "biomero_zarr_viewer/openwith-v2.js"}]'

config set -- omero.web.zarr_viewer.source_root '{{ biomero_zarr_source_root }}'
config set -- omero.web.zarr_viewer.mount_root '{{ biomero_zarr_web_mount_root }}'
config set -- omero.web.zarr_viewer.internal_prefix '/_biomero_zarr_internal/'
config set -- omero.web.zarr_viewer.context_ttl_seconds 900
config set -- omero.web.zarr_viewer.max_metadata_bytes 4194304
config set -- omero.web.zarr_viewer.max_hierarchy_entries 20000
