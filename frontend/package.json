{
  "name": "biomero-zarr-viewer-frontend",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-output.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "build": "npm run licenses && npm run clean && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deck.gl/core": "9.3.7",
    "@deck.gl/react": "9.3.7",
    "@hms-dbmi/viv": "0.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zarrita": "0.7.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "image-size": "2.0.4",
    "nanoid": "3.3.18"
  }
}
