{
  "name": "biomero-zarr-viewer-frontend",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean-output.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "build": "npm run licenses && npm run clean && tsc --noEmit && vite build && vite build --config vite.neuroglancer.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:movie": "node scripts/smoke-movie.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@hms-dbmi/viv": "0.23.0",
    "@math.gl/core": "4.1.0",
    "mediabunny": "1.61.0",
    "neuroglancer": "2.41.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zarrita": "0.7.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "26.1.0",
    "playwright-core": "1.62.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ikonate": {
      ".": "1.1.1",
      "jsdom": "npm:dry-uninstall@0.3.0",
      "xmldom": "npm:dry-uninstall@0.3.0",
      "pretty": "npm:dry-uninstall@0.3.0"
    },
    "fflate@>=0.7.0 <0.7.5": "0.7.5",
    "@loaders.gl/textures": {
      "texture-compressor": "npm:dry-uninstall@0.3.0"
    },
    "image-size": "2.0.4",
    "nanoid": "3.3.18"
  }
}
