# syntax=docker/dockerfile:1
# check=skip=InvalidDefaultArgInFrom
# Add the optional provider to an existing combined BIOMERO web image.
# Supply an immutable registry digest or a locally preserved base image.
ARG BIOMERO_WEB_IMAGE
FROM ${BIOMERO_WEB_IMAGE}

ARG ENABLE_HTTP_ZARR=false
USER root
COPY install-http-zarr.py 91-omero-web-zarr.omero /tmp/
RUN /opt/omero/web/venv3/bin/python -c "import biomero_zarr_viewer" \
    && /opt/omero/web/venv3/bin/python /tmp/install-http-zarr.py "${ENABLE_HTTP_ZARR}" \
    && /opt/omero/web/venv3/bin/python -m pip check \
    && rm -f /tmp/omero-web-zarr-source.tar.gz

LABEL org.nlbioimaging.zarrviewer.provider-requested="${ENABLE_HTTP_ZARR}" \
      org.nlbioimaging.zarrviewer.provider-commit="3afc184a9c3dcab090bd4a92effcf5e45ae4c864" \
      org.nlbioimaging.zarrviewer.provider-repository="https://github.com/NL-BioImaging/omero-web-zarr"
USER omero-web
